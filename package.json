{
  "name": "@ai-ecoverse/slicc-agent",
  "version": "0.0.0",
  "description": "SLICC's agent core on pi durable: an agent worker, session storage, remoting and pi extensions",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-agent.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-agent",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spectrum": {
      "types": "./dist/types/spectrum/index.d.ts",
      "default": "./dist/spectrum/index.js"
    },
    "./page": {
      "types": "./dist/types/page.d.ts",
      "default": "./dist/page.js"
    },
    "./agent-worker": {
      "types": "./dist/types/agent-worker.d.ts",
      "default": "./dist/agent-worker.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "packages/vfs-root"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "npm run build && node test/integration/chrome.mjs",
    "pretest": "npm run build && node test/integration/build.mjs && playwright-core install --no-shell chromium",
    "test": "node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --test-timeout=120000 --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "eval:judge": "node evals/judge.mjs",
    "lint": "slicc-lint && npm run lint:patches && npm run lint:chord && npm run lint:vault-pi",
    "lint:chord": "node scripts/verdict.mjs check-chord scripts/check-chord.mjs",
    "lint:patches": "node scripts/verdict.mjs check-patches scripts/check-patches.mjs",
    "lint:vault-pi": "node scripts/verdict.mjs check-vault-pi scripts/check-vault-pi.mjs",
    "reach": "node scripts/verdict.mjs reach scripts/reach.mjs",
    "format": "biome check --write .",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-kernel": "1.130.0",
    "@ai-ecoverse/slicc-scrub": "1.0.0",
    "@ai-ecoverse/slicc-shared-web": "1.24.2",
    "@ai-ecoverse/slicc-spectrum": "1.95.0",
    "@ai-ecoverse/wasi-fnox": "1.39.0-5",
    "@ai-ecoverse/wasm-bash": "5.3.0-20",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-10",
    "@ai-ecoverse/wasm-git": "2.55.0-17",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "lefthook": "2.2.1",
    "monocart-coverage-reports": "2.13.2",
    "playwright-core": "1.64.0",
    "semantic-release": "25.0.9",
    "slicc-agent-5": "npm:@ai-ecoverse/slicc-agent@5.10.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-ecoverse/slicc-browsers": "1.8.5",
    "@ai-ecoverse/slicc-vault": "1.12.2",
    "@aws-sdk/middleware-websocket": "^3.972.54",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "typebox": "1.3.36"
  },
  "peerDependencies": {
    "@ai-ecoverse/slicc-kernel": ">=1.110.0 <2",
    "@ai-ecoverse/slicc-spectrum": "^1.88.0"
  },
  "peerDependenciesMeta": {
    "@ai-ecoverse/slicc-spectrum": {
      "optional": true
    }
  }
}
