{
  "name": "@ai-ecoverse/slicc-agent",
  "version": "0.0.0",
  "description": "SLICC's agent core on pi durable: an agent worker, session storage, remoting and pi extensions",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-agent.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-agent",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spectrum": {
      "types": "./dist/types/spectrum/index.d.ts",
      "default": "./dist/spectrum/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "npm run build && node test/integration/chrome.mjs",
    "pretest": "npm run build && node test/integration/build.mjs && playwright-core install --no-shell chromium",
    "test": "node --test --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.5.0",
    "@ai-ecoverse/slicc-spectrum": "1.7.0",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "lefthook": "2.1.16",
    "monocart-coverage-reports": "2.13.0",
    "playwright-core": "1.63.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-client": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-protocol": "1.0.4",
    "@earendil-works/pi-server": "1.0.4",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2"
  },
  "peerDependencies": {
    "@ai-ecoverse/slicc-spectrum": "^1.7.0"
  }
}
